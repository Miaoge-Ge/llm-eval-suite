[Unit]
Description=LLM Eval Suite web workbench
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=llm-eval
Group=llm-eval
SupplementaryGroups=docker
WorkingDirectory=/opt/llm-eval-suite
EnvironmentFile=/etc/llm-eval-suite.env
Environment=LLM_EVAL_STATE_DIR=/var/lib/llm-eval-suite
Environment=LLM_EVAL_HOST=127.0.0.1
Environment=LLM_EVAL_PORT=8080
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/llm-eval-suite/.venv/bin/llm-eval-web
Restart=on-failure
RestartSec=5
TimeoutStopSec=150
UMask=0077
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
# Host Docker must see the same absolute temporary paths as the worker.
PrivateTmp=false

[Install]
WantedBy=multi-user.target
